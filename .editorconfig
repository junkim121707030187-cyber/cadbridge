root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Recorded runtime outputs and provenance. Other files store their SHA256,
# so editors must keep the existing line endings and final newline on save.
[prototype/{data,evidence,source-provenance}/**]
end_of_line = unset
insert_final_newline = unset

[prototype/examples/terra-execution.json]
end_of_line = unset
insert_final_newline = unset
